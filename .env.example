# ============================================================
# 멀티테넌트 쇼핑몰 환경변수 템플릿
# 복사 후 .env 로 저장하고 실제 값으로 교체하세요.
# ============================================================

# JWT (최소 32자 이상의 랜덤 문자열 권장)
JWT_ACCESS_SECRET=change-me-access-secret-min-32chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# Bootstrap 슈퍼관리자 초기 계정 (최초 기동 시 1회 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme1234!

# CORS 허용 오리진 (콤마 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
