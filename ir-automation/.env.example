# === Discord (사후 대응 알림) ===
# 앱 1차 탐지 알림과 별도. 커밋 금지 — .env 로만 주입.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/[webhook-url-here]
# CRITICAL 전용(선택). 미설정 시 위 기본 URL 로 fallback — 인프라 준비 전에도 동작.
# DISCORD_WEBHOOK_URL_CRITICAL=https://discord.com/api/webhooks/[critical-webhook-url-here]

# === Logging ===
LOG_LEVEL=INFO

# === Incident / Blocklist Storage ===
INCIDENT_STORAGE_PATH=./incidents
# 통계·인덱스 (incidents 와 형제). IP/type 당 최근 1000건 유지
INCIDENT_META_PATH=./incident_meta
BLOCKLIST_PATH=./incidents/blocklist.json

# === Block TTL (초) ===
DEFAULT_BLOCK_DURATION=60
CRITICAL_BLOCK_DURATION=120
# 주기적 만료 해제 간격(초). 트래픽이 없어도 TTL 이 제때 풀리게 함(0=끔).
RECONCILE_INTERVAL_SECONDS=30

# === 차단 모드 + 안전장치 ===
# simulation(기본, 실제 네트워크 미변경) | nginx | aws_waf
BLOCK_MODE=simulation
# 차단 예외: 정확 IP 또는 CIDR, 콤마구분 (예: 1.2.3.4,10.0.0.0/8)
ALLOWLIST_IPS=
# 사설/루프백 IP 차단 여부(기본 false = 개발망 오차단 방지)
BLOCK_PRIVATE_IPS=false

# === nginx 모드 (BLOCK_MODE=nginx 일 때) ===
NGINX_DENY_FILE=./incidents/deny.conf
NGINX_RELOAD_CMD=nginx -s reload

# === aws_waf 모드 (BLOCK_MODE=aws_waf 일 때, pip install '.[waf]') ===
AWS_REGION=
WAF_IPSET_ID=
WAF_IPSET_NAME=
WAF_SCOPE=REGIONAL

# === 컨텍스트 스코어링 ===
# TODO(sync-with-backend): 서비스 TZ 팀원 최종 확인 필요
SERVICE_TIMEZONE=Asia/Seoul
NIGHT_HOURS_START=0
NIGHT_HOURS_END=6
# 같은 IP 재범 판정 윈도우(초). 기본 10분
RECIDIVISM_WINDOW_SECONDS=600
