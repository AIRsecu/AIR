# ── 비밀/환경 (절대 커밋 금지) ─────────────────────────────
.env
.env.local
.env.example
*.pem
*.key
secrets/
application-local.*

# ── SQLite DB ──────────────────────────────────────────────
*.db
*.db-wal
*.db-shm
shop.db*

# ── 빌드 산출물 ────────────────────────────────────────────
target/
build/
*.class
*.jar
!**/maven-wrapper.jar
reports/

# ── 로그 ───────────────────────────────────────────────────
*.log
logs/

# ── Python (공격 모듈) ─────────────────────────────────────
__pycache__/
*.pyc

# ── 프론트엔드(혹시 모를) 의존성 ───────────────────────────
node_modules/
dist/

# ── IDE / 에디터 ───────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── DAST 스캔 결과 ─────────────────────────────────────────
dast/zap/reports/
reports/dast/

# ── IR Automation ──────────────────────────────────────────
ir-automation/.env
ir-automation/incidents/*
!ir-automation/incidents/.gitkeep
ir-automation/logs/*
!ir-automation/logs/.gitkeep
ir-automation/*.db
ir-automation/**/__pycache__/

# ── 리포트 파일──────────────────────────────────────────────
reports/