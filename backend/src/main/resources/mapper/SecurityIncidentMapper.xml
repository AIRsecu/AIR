<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shop.air.SecurityIncidentMapper">

    <resultMap id="IncidentRM" type="com.shop.air.SecurityIncident">
        <id     property="id"          column="id"/>
        <result property="type"        column="type"/>
        <result property="endpoint"    column="endpoint"/>
        <result property="clientIp"    column="client_ip"/>
        <result property="actor"       column="actor"/>
        <result property="payload"     column="payload"/>
        <result property="actionTaken" column="action_taken"/>
        <result property="status"      column="status"/>
        <result property="createdAt"   column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.shop.air.SecurityIncident">
        INSERT INTO security_incidents
            (id, type, endpoint, client_ip, actor, payload, action_taken, status, created_at)
        VALUES
            (#{id}, #{type}, #{endpoint}, #{clientIp}, #{actor}, #{payload},
             #{actionTaken}, #{status}, datetime('now'))
    </insert>

    <update id="updateStatus">
        UPDATE security_incidents
        SET status = #{status}, action_taken = #{actionTaken}
        WHERE id = #{id}
    </update>

    <select id="findRecent" resultMap="IncidentRM">
        SELECT * FROM security_incidents ORDER BY created_at DESC LIMIT #{limit}
    </select>

</mapper>
